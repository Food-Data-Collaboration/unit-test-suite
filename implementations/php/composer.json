{
    "name": "dfc-test/php-connector",
    "description": "DFC interop test runner for PHP",
    "type": "project",
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:junit": "phpunit --configuration phpunit.xml --log-junit ../../results/php-connector/results.xml"
    },
    "require": {
        "php": "^8.1",
        "ml/jsonld": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/yaml": "^6.0"
    }
}
